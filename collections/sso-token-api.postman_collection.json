      "item": [
        {
          "id": "5d26d874-5c23-4486-8c0f-c7133c8d2b43",
          "name": "Exchange Authorization Code for Tokens",
          "request": {
            "name": "Exchange Authorization Code for Tokens",
            "description": {
              "content": "Exchanges an authorization code for an access token, ID token, and optionally a refresh token. Also used to refresh expired access tokens using a refresh token. Supports client_secret_basic and client_secret_post authentication methods.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "grant_type",
                  "value": "<string>",
                  "description": "(Required) The grant type for the token request"
                },
                {
                  "disabled": false,
                  "key": "code",
                  "value": "<string>",
                  "description": "Authorization code received from the authorization endpoint. Required for authorization_code grant."
                },
                {
                  "disabled": false,
                  "key": "redirect_uri",
                  "value": "<uri>",
                  "description": "Must match the redirect_uri used in the authorization request. Required for authorization_code grant."
                },
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "Client identifier. Required for client_secret_post authentication."
                },
                {
                  "disabled": false,
                  "key": "client_secret",
                  "value": "<string>",
                  "description": "Client secret. Required for client_secret_post authentication."
                },
                {
                  "disabled": false,
                  "key": "code_verifier",
                  "value": "<string>",
                  "description": "PKCE code verifier. Required when code_challenge was used in the authorization request."
                },
                {
                  "disabled": false,
                  "key": "refresh_token",
                  "value": "<string>",
                  "description": "Refresh token for obtaining new access tokens. Required for refresh_token grant."
                },
                {
                  "disabled": false,
                  "key": "scope",
                  "value": "<string>",
                  "description": "Optional scope for refresh_token grant. Must be a subset of originally granted scopes."
                }
              ]
            }
