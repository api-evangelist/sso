      "name": "Keys",
      "description": {
        "content": "JSON Web Key Set (JWKS) endpoint for retrieving public keys used to verify ID token signatures.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "899bbad9-96d0-4bd0-b29c-f9c4af423a06",
          "name": "Get JSON Web Key Set",
          "request": {
            "name": "Get JSON Web Key Set",
            "description": {
              "content": "Returns the JSON Web Key Set (JWKS) containing the public keys used by the OpenID Provider to sign ID tokens and other JWTs. Clients use these keys to verify the signature of ID tokens received from the token endpoint.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "jwks"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "02429bc1-2944-4d5b-bfc2-17f7ca1a19c5",
              "name": "JSON Web Key Set",
              "originalRequest": {
                "url": {
                  "path": [
                    "jwks"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"keys\": [\n    {\n      \"kty\": \"RSA\",\n      \"use\": \"sig\",\n      \"kid\": \"string\",\n      \"alg\": \"RS256\",\n      \"n\": \"string\",\n      \"e\": \"string\",\n      \"x5c\": [\n        \"string\",\n        \"string\"\n      ],\n      \"x5t\": \"string\"\n    },\n    {\n      \"kty\": \"RSA\",\n      \"use\": \"enc\",\n      \"kid\": \"string\",\n      \"alg\": \"RS256\",\n      \"n\": \"string\",\n      \"e\": \"string\",\n      \"x5c\": [\n        \"string\",\n        \"string\"\n      ],\n      \"x5t\": \"string\"\n    }\n  ]\n}",
